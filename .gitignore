# Anchor / Rust
.anchor
target
**/*.rs.bk
test-ledger

# Node
node_modules
.yarn
*.tsbuildinfo

# Next.js
web/.next
web/out
web/next-env.d.ts

# Secrets. The faucet key that hands out test tokens lives in web/.env.local and
# must never be committed.
.env
.env.*
!.env.example

# The dedicated faucet keypair, written by scripts/split-faucet-key.mjs. It is
# the mint authority for the mirror mints on the write cluster and nothing else,
# but it is still a secret key.
.faucet-key.json

# The create-next-app scaffold history, kept out of the way when this became a
# single repository. Nothing depends on it.
.web-git-scaffold

# The keypair scripts/demo-video.mjs signs the recorded demo with, and what it
# records. Both are local artefacts: the key holds a little devnet SOL, and the
# video is uploaded, not committed.
.demo-key.json
demo/

# Local mirror addresses, rewritten by scripts/setup-mirror.mjs per cluster.
.mirror-state.json
.mirror-state-prestocks.json

.DS_Store

# Editor and assistant scratch files. web/AGENTS.md in particular is regenerated
# by `next dev` on every run, so tracking it means a permanent dirty file.
AGENTS.md
CLAUDE.md
web/AGENTS.md
web/CLAUDE.md
.claude/

# Submission prep: form copy, the shot list for the demo, and rubric notes.
# Useful locally, not part of the project.
SUBMISSION.md
TECHNICAL-VIDEO.md
PITCH-VIDEO.md
.shots/
