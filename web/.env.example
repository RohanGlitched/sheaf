# Copy to .env.local. Only the lines marked SECRET are secret.

# Where mint and redeem transactions settle: "devnet" or "localnet".
NEXT_PUBLIC_WRITE_CLUSTER=devnet

# Leave unset to use the cluster's default endpoint
# (https://api.devnet.solana.com, or http://127.0.0.1:8899 for localnet).
# NEXT_PUBLIC_WRITE_RPC=

# The deployed Sheaf program. Matches programs/sheaf/src/lib.rs.
NEXT_PUBLIC_SHEAF_PROGRAM_ID=F8QLTZPe9mJuPgXCbccnU9G2kMSEE4inygdUw3QZbrQ

# SECRET. A Solami API key (free tier at solami.dev, no card). The market route
# reads every mint's supply and dividend multiplier from mainnet through it.
# Server-side only. Leave unset to fall back to the public mainnet endpoint.
SOLAMI_API_KEY=

# The public mainnet endpoint used when SOLAMI_API_KEY is unset.
# NEXT_PUBLIC_MAINNET_RPC=

# SECRET. The secret key of the wallet holding the mirror mints' mint authority,
# used by /api/faucet to hand test tokens to throwaway wallets. Read server-side
# only, never sent to the browser. Accepts either base58 or a JSON byte array, so
# the contents of a `solana-keygen` file paste in directly.
#
# Do not use your deploy wallet here. `scripts/split-faucet-key.mjs` creates a key
# whose only power is minting the mirror stand-ins on a test cluster, and writes it
# into .env.local for you; go-devnet.sh runs it as its last step. That way nothing
# in a hosting dashboard can touch the program's upgrade authority.
FAUCET_SECRET_KEY=
