{
  "address": "F8QLTZPe9mJuPgXCbccnU9G2kMSEE4inygdUw3QZbrQ",
  "metadata": {
    "name": "sheaf",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Sheaf: permissionless in-kind index baskets for tokenized equities on Solana"
  },
  "instructions": [
    {
      "name": "create_basket",
      "docs": [
        "Publish a basket recipe and take ownership of its share mint.",
        "",
        "The share mint is created by the client (a Token-2022 mint carrying",
        "on-chain metadata) with its mint authority already set to this basket's",
        "PDA. We verify that here rather than trusting it."
      ],
      "discriminator": [
        47,
        105,
        155,
        148,
        15,
        169,
        202,
        211
      ],
      "accounts": [
        {
          "name": "creator",
          "writable": true,
          "signer": true
        },
        {
          "name": "basket",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  98,
                  97,
                  115,
                  107,
                  101,
                  116
                ]
              },
              {
                "kind": "account",
                "path": "creator"
              },
              {
                "kind": "arg",
                "path": "symbol"
              }
            ]
          }
        },
        {
          "name": "share_mint"
        },
        {
          "name": "component_token_program"
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "symbol",
          "type": "string"
        },
        {
          "name": "creator_fee_bps",
          "type": "u16"
        },
        {
          "name": "components",
          "type": {
            "vec": {
              "defined": {
                "name": "ComponentArg"
              }
            }
          }
        }
      ]
    },
    {
      "name": "mint_shares",
      "docs": [
        "Deposit the recipe in kind and receive `shares` share tokens.",
        "",
        "`remaining_accounts` is three per component, in basket order:",
        "`[component_mint, depositor_token_account, basket_vault_ata]`."
      ],
      "discriminator": [
        24,
        196,
        132,
        0,
        183,
        158,
        216,
        142
      ],
      "accounts": [
        {
          "name": "basket",
          "writable": true
        },
        {
          "name": "share_mint",
          "writable": true
        },
        {
          "name": "depositor",
          "signer": true
        },
        {
          "name": "depositor_share_account",
          "writable": true
        },
        {
          "name": "creator_share_account",
          "writable": true,
          "optional": true
        },
        {
          "name": "share_token_program"
        },
        {
          "name": "component_token_program"
        }
      ],
      "args": [
        {
          "name": "shares",
          "type": "u64"
        }
      ]
    },
    {
      "name": "redeem_shares",
      "docs": [
        "Burn `shares` and take the underlying components back out, pro rata.",
        "",
        "`remaining_accounts` is three per component, in basket order:",
        "`[component_mint, basket_vault_ata, recipient_token_account]`."
      ],
      "discriminator": [
        239,
        154,
        224,
        89,
        240,
        196,
        42,
        187
      ],
      "accounts": [
        {
          "name": "basket",
          "writable": true
        },
        {
          "name": "share_mint",
          "writable": true
        },
        {
          "name": "owner",
          "signer": true
        },
        {
          "name": "owner_share_account",
          "writable": true
        },
        {
          "name": "share_token_program"
        },
        {
          "name": "component_token_program"
        }
      ],
      "args": [
        {
          "name": "shares",
          "type": "u64"
        }
      ]
    }
  ],
