{
  "name": "sheaf-contracts",
  "version": "1.0.0",
  "description": "Sheaf EVM contracts: immutable in-kind basket vaults of tokenized stocks, the factory and a stablecoin creation desk",
  "private": true,
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:robinhood": "hardhat run scripts/deploy-chain.js --network robinhoodTestnet",
    "deploy:tempo": "hardhat run scripts/deploy-chain.js --network tempoTestnet",
    "smoke:robinhood": "hardhat run scripts/smoke.js --network robinhoodTestnet",
    "smoke:tempo": "hardhat run scripts/smoke.js --network tempoTestnet",
    "verify:robinhood": "hardhat run scripts/verify.js --network robinhoodTestnet",
    "verify:tempo": "hardhat run scripts/verify-sourcify.js --network tempoTestnet",
    "sip:tempo": "node scripts/tempo-sip.mjs",
    "deploy:v2:robinhood": "hardhat run scripts/deploy-v2.js --network robinhoodTestnet",
    "deploy:v2:tempo": "hardhat run scripts/deploy-v2.js --network tempoTestnet",
    "smoke:v2:robinhood": "hardhat run scripts/smoke-v2.js --network robinhoodTestnet",
    "smoke:v2:tempo": "hardhat run scripts/smoke-v2.js --network tempoTestnet",
    "verify:v2:robinhood": "hardhat run scripts/verify-v2.js --network robinhoodTestnet",
    "verify:v2:tempo": "hardhat run scripts/verify-v2.js --network tempoTestnet",
    "sip:v2:tempo": "node scripts/tempo-sip-v2.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2",
    "viem": "2.56.8"
  }
}
